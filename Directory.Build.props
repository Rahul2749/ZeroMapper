<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>1.0.1-preview.1</Version>
    <Authors>ZeroMapper contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Rahul2749/ZeroMapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Rahul2749/ZeroMapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>Patch preview: reuse generated source for unchanged mappers, warn on non-writable create matches (ZM008), bound generated filenames, and include embedded Source Link symbols for the generator.</PackageReleaseNotes>
    <Title>ZeroMapper: source-generated object mapper</Title>
    <PackageTags>mapper;mapping;object-mapper;automapper;dto;source-generator</PackageTags>
    <Description>A strict, source-generated object mapper for .NET with protected members and explicit update allow-lists.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
